{
  "viewport": { "width": 1280, "height": 800 },
  "steps": [
    {
      "label": "1,000行作成",
      "do": { "action": "click", "selector": "#run" },
      "expect": [
        { "assert": "count", "selector": "tbody > tr", "equals": 1000 },
        {
          "assert": "text",
          "selector": "tbody > tr:nth-child(2) > td:first-child",
          "contains": "2"
        }
      ]
    },
    {
      "label": "10行ごとの更新",
      "do": { "action": "click", "selector": "#update" },
      "expect": [
        {
          "assert": "text",
          "selector": "tbody > tr:first-child > td:nth-child(2)",
          "contains": " !!!"
        },
        {
          "assert": "text",
          "selector": "tbody > tr:nth-child(11) > td:nth-child(2)",
          "contains": " !!!"
        }
      ]
    },
    {
      "label": "2行の交換",
      "do": { "action": "click", "selector": "#swaprows" },
      "expect": [
        {
          "assert": "text",
          "selector": "tbody > tr:nth-child(2) > td:first-child",
          "contains": "999"
        },
        {
          "assert": "text",
          "selector": "tbody > tr:nth-child(999) > td:first-child",
          "contains": "2"
        }
      ]
    },
    {
      "label": "行選択",
      "do": { "action": "click", "selector": "tbody > tr:nth-child(2) > td:nth-child(2) > a" },
      "expect": [
        {
          "assert": "attr",
          "selector": "tbody > tr:nth-child(2)",
          "name": "class",
          "equals": "danger"
        }
      ]
    },
    {
      "label": "行削除",
      "do": {
        "action": "click",
        "selector": "tbody > tr:nth-child(2) > td:nth-child(3) > a > span"
      },
      "expect": [
        { "assert": "count", "selector": "tbody > tr", "equals": 999 },
        { "assert": "count", "selector": "tbody > tr.danger", "equals": 0 }
      ]
    },
    {
      "label": "1,000行追加",
      "do": { "action": "click", "selector": "#add" },
      "expect": [{ "assert": "count", "selector": "tbody > tr", "equals": 1999 }]
    },
    {
      "label": "全行削除",
      "do": { "action": "click", "selector": "#clear" },
      "expect": [{ "assert": "count", "selector": "tbody > tr", "equals": 0 }]
    },
    {
      "label": "10,000行作成",
      "do": { "action": "click", "selector": "#runlots" },
      "expect": [{ "assert": "count", "selector": "tbody > tr", "equals": 10000 }]
    }
  ]
}
