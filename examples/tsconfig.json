{
  // authored .jsx 専用の型検査基盤(ROADMAP次のアクション10、
  // openspec/changes/jsx-type-checking-foundation/design.md参照)。
  // ルートの tsconfig.json とは独立させている ― allowJs/checkJs を
  // ルートへ足すと examples/*.handwritten.js
  // (test/todomvc-handwritten.test.ts からimportされる比較用の手書きJS、
  // 型検査の対象外)まで検査対象になり、既存の @ts-expect-error が
  // 無効化されて壊れる。strict は意図的に off ― authored .jsx は
  // 型注釈を書けない素のJS構文なので、strict(noImplicitAny等)を
  // 掛けるとハンドラ引数のほぼ全てが implicit any でエラーになり
  // 実用にならない。タグ名の存在チェック・signal/derivedの型・
  // JSX属性の形は strict なしでも効く(design.md参照)。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "jsx": "preserve",
    // node_modules/@types配下(@types/reactなど)を自動包含させない ―
    // 既定だと@types/reactの`declare global JSX`が本プロジェクト独自の
    // types/jsx.d.tsの`JSX`namespaceを踏み potentially つぶす(実際に
    // DetailedHTMLProps等React型のエラーが出て発覚した)。
    "types": [],
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "strict": false
  },
  "include": ["**/*.jsx", "../types/jsx.d.ts"]
}
