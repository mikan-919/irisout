{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "irisout-playground-run",
  "main": "./controller-worker.mjs",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "vars": {
    "IRISOUT_SITE_ORIGIN": "https://irisout-site.mikan-919.workers.dev",
  },
}
