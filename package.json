{
  "name": "irisout-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp -C apps/examples dev",
    "dev:list": "IRISOUT_ENTRY=list.jsx vp -C apps/examples dev",
    "dev:notes": "IRISOUT_ENTRY=notes.jsx vp -C apps/examples dev",
    "dev:heatmap": "IRISOUT_ENTRY=heatmap.jsx vp -C apps/examples dev",
    "dev:todomvc": "IRISOUT_ENTRY=todomvc.jsx vp -C apps/examples dev",
    "dev:multi-file": "IRISOUT_ENTRY=multi-file/App.jsx vp -C apps/examples dev",
    "build": "vp -C apps/examples build",
    "build:inspect": "IRISOUT_MINIFY=false vp -C apps/examples build",
    "start": "bun run build && vp -C apps/examples preview",
    "check": "vp check && bun run typecheck:tsc",
    "check:fix": "vp check --fix && bun run typecheck:tsc",
    "lint": "vp lint",
    "typecheck": "vp check --no-fmt --no-lint && bun run typecheck:tsc",
    "typecheck:jsx": "tsc --noEmit -p apps/examples/tsconfig.json",
    "typecheck:tsc": "tsc --noEmit && bun run typecheck:jsx",
    "test": "vp test --run",
    "bench": "vp run @irisout/bench#bench",
    "bench:browser": "vp run @irisout/bench#bench:browser",
    "bench:heatmap": "vp run @irisout/bench#bench:heatmap",
    "bench:todomvc-compiler": "vp run @irisout/bench#bench:todomvc-compiler",
    "bench:list-runtime": "vp run @irisout/bench#bench:list-runtime",
    "bench:listener-strategy": "vp run @irisout/bench#bench:listener-strategy",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.0",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.3.13"
}
