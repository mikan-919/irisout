{
  "name": "irisout-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "fixtures/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vp -C apps/demos build",
    "build:web": "node apps/web/scripts/build-docs.mjs && vp -C apps/web build && bun run --cwd apps/web build:ssr",
    "site:build": "node apps/web/scripts/build-docs.mjs",
    "site:check": "node apps/web/scripts/build-docs.mjs --check",
    "site:test": "node --test apps/web/scripts/site-docs.test.mjs",
    "test:web:playground": "bun run --cwd apps/web test:playground",
    "test:web:server": "bun run --cwd apps/web test:server",
    "test:web:save": "bun run --cwd apps/web test:save",
    "build:inspect": "IRISOUT_MINIFY=false vp -C apps/demos build",
    "start": "bun run build && vp -C apps/demos preview",
    "check": "vp check && bun run typecheck:tsc",
    "check:fix": "vp check --fix && bun run typecheck:tsc",
    "lint": "vp lint",
    "typecheck": "vp check --no-fmt --no-lint && bun run typecheck:tsc",
    "typecheck:jsx": "tsc --noEmit -p apps/demos/tsconfig.json",
    "typecheck:consumer": "tsc --noEmit -p fixtures/consumer-app/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:tsc": "tsc --noEmit && bun run typecheck:jsx && bun run typecheck:consumer && bun run typecheck:web",
    "test": "vp test --run",
    "bench": "vp run @irisout/bench#bench",
    "bench:browser": "vp run @irisout/bench#bench:browser",
    "bench:heatmap": "vp run @irisout/bench#bench:heatmap",
    "bench:todomvc-compiler": "vp run @irisout/bench#bench:todomvc-compiler",
    "bench:list-runtime": "vp run @irisout/bench#bench:list-runtime",
    "bench:listener-strategy": "vp run @irisout/bench#bench:listener-strategy",
    "build:packages": "node scripts/build-packages.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "registry:smoke": "IRISOUT_PACKAGE_SPEC=0.2.2 node scripts/pack-smoke.mjs",
    "prepare": "node scripts/build-packages.mjs && husky"
  },
  "devDependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@mizchi/vlmkit": "0.22.0",
    "@types/node": "^24.0.0",
    "hono": "^4.13.8",
    "husky": "^9.1.7",
    "motion": "^13.4.0",
    "typescript": "^5.9.0",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.3.13"
}
